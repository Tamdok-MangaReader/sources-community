{
  "config": {},
  "requiredConfig": [
    "siteId",
    "siteName",
    "baseUrl"
  ],
  "info": {
    "languages": [
      "ru"
    ],
    "minAppVersion": "1.3"
  },
  "listings": [
    {
      "id": "popular",
      "name": "Популярное",
      "kind": "list"
    },
    {
      "id": "currently_reading",
      "name": "Сейчас читают",
      "kind": "list"
    },
    {
      "id": "latest",
      "name": "Последние обновления",
      "kind": "list"
    }
  ],
  "settings": [
    {
      "type": "group",
      "title": "Настройки",
      "items": [
        {
          "type": "text",
          "id": "baseUrl",
          "title": "Веб домен",
          "default": "{{config.baseUrl}}"
        },
        {
          "type": "select",
          "id": "apiUrl",
          "title": "Домен API",
          "options": [
            {
              "id": "https://api.cdnlibs.org",
              "label": "Резервный (api.cdnlibs.org)"
            },
            {
              "id": "https://hapi.hentaicdn.org",
              "label": "Резервный 2 (hapi.hentaicdn.org)"
            },
            {
              "id": "https://api.imglib.info",
              "label": "Официальное приложение (api.imglib.info)"
            }
          ],
          "default": "https://hapi.hentaicdn.org"
        },
        {
          "type": "select",
          "id": "imageServerUrl",
          "title": "Сервер изображений",
          "options": [
            {
              "id": "compress",
              "label": "Сжатия"
            },
            {
              "id": "main",
              "label": "Первый"
            },
            {
              "id": "secondary",
              "label": "Второй"
            }
          ],
          "default": "compress"
        },
        {
          "type": "select",
          "id": "coverQuality",
          "title": "Качество обложки",
          "options": [
            {
              "id": "thumbnail",
              "label": "Миниатюра"
            },
            {
              "id": "default",
              "label": "Стандартное"
            },
            {
              "id": "md",
              "label": "Среднее"
            },
            {
              "id": "orig",
              "label": "Оригинал"
            }
          ],
          "default": "default"
        }
      ]
    },
    {
      "type": "group",
      "title": "Аккаунт",
      "footer": "Нажмите «Войти», авторизуйтесь на сайте и нажмите «Сохранить»: токен доступа будет скопирован автоматически. Его можно и вставить вручную (access_token или значение auth из localStorage сайта).",
      "items": [
        {
          "type": "login",
          "id": "login",
          "title": "Войти и сохранить токен",
          "url": "{{config.baseUrl}}",
          "captureLocalStorage": {
            "key": "auth",
            "setting": "authToken"
          }
        },
        {
          "type": "text",
          "id": "authToken",
          "title": "Токен доступа",
          "default": "",
          "secure": true
        }
      ]
    }
  ]
}
